<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controller.MainController"
            stylesheets="@style.css"
            prefWidth="1180.0" prefHeight="780.0">

    <!-- Top Bar Header -->
    <top>
        <VBox spacing="4.0">
            <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15.0">
                <!-- Branding -->
                <Label text="Guess Market" styleClass="app-title"/>
                <Label text="Prediction Market Platform" style="-fx-text-fill: #8f92a1; -fx-font-size: 11px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Current User Info Badge -->
                <HBox alignment="CENTER" spacing="12.0" style="-fx-background-color: #1e1e2f; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-border-color: #383a53; -fx-border-radius: 6px;">
                    <Label fx:id="userGreetingLabel" text="👤 Connecting..." style="-fx-font-weight: bold; -fx-text-fill: #00f2fe; -fx-font-size: 13px;"/>
                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.3;"/>
                    <Label fx:id="balanceHeaderLabel" text="Balance: $0.00" style="-fx-font-weight: bold; -fx-text-fill: #2dce89; -fx-font-size: 13px;"/>
                </HBox>

                <!-- Actions: Charge & Upload -->
                <Button fx:id="chargeButton" text="Charge Balance" onAction="#handleChargeFunds"
                        styleClass="btn-success" style="-fx-font-size: 12px;"/>
                <Button fx:id="uploadXmlButton" text="Upload XML Events" onAction="#handleUploadXml"
                        styleClass="btn-primary" style="-fx-font-size: 12px;"/>
            </HBox>

            <!-- Status & Polling Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #27293d; -fx-padding: 4px 18px;">
                <Label fx:id="statusLabel" text="🟢 Connected to server" styleClass="stat-label" style="-fx-font-size: 11px;"/>
                <ProgressBar fx:id="progressBar" prefWidth="200.0" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="syncVersionLabel" text="Sync Version: v1" style="-fx-text-fill: #8f92a1; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content TabPane -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Events & Trading Tab -->
                <Tab fx:id="eventsTab" text="📊 Events &amp; Trading">
                    <content>
                        <fx:include fx:id="eventsTabView" source="events_tab.fxml"/>
                    </content>
                </Tab>

                <!-- User Profile & Other Users Tab -->
                <Tab fx:id="usersTab" text="👤 Users &amp; Portfolios">
                    <content>
                        <fx:include fx:id="usersTabView" source="users_tab.fxml"/>
                    </content>
                </Tab>

                <!-- Chat Room Tab (Bonus) -->
                <Tab fx:id="chatTab" text="💬 Chat Room (Bonus)">
                    <content>
                        <fx:include fx:id="chatTabView" source="chat_tab.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
