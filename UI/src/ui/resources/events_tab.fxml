<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.controller.EventsTabController"
           dividerPositions="0.4">

    <!-- Left Panel: Filter Line & Events List -->
    <VBox spacing="10.0">
        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>

        <!-- Filter Controls -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card-panel">
            <VBox spacing="2.0">
                <Label text="Type:" styleClass="stat-label"/>
                <ComboBox fx:id="typeFilterCombo" prefWidth="110.0"/>
            </VBox>
            <VBox spacing="2.0">
                <Label text="Status:" styleClass="stat-label"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="110.0"/>
            </VBox>
            <VBox spacing="2.0">
                <Label text="Fee Method:" styleClass="stat-label"/>
                <ComboBox fx:id="commissionFilterCombo" prefWidth="120.0"/>
            </VBox>
        </HBox>

        <!-- Events Table -->
        <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40.0"/>
                <TableColumn fx:id="colName" text="Event Name" prefWidth="110.0"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="90.0"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0"/>
                <TableColumn fx:id="colCommission" text="Commission" prefWidth="100.0"/>
                <TableColumn fx:id="colMarketMaker" text="MM" prefWidth="80.0"/>
                <TableColumn fx:id="colBalance" text="Balance" prefWidth="80.0"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right Panel: Event Details & Trade -->
    <ScrollPane fitToWidth="true">
        <VBox spacing="15.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <!-- Event Header Info -->
            <VBox styleClass="card-panel" spacing="8.0">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label fx:id="eventNameLabel" text="Select an Event" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="activateButton" text="Activate Event (MM)" onAction="#handleActivateEvent" styleClass="btn-success"/>
                    <Button fx:id="closeEventButton" text="Close Event (MM)" onAction="#handleCloseEvent" styleClass="btn-danger"/>
                </HBox>
                <Label fx:id="eventDescriptionLabel" text="Select an event from the table on the left to view details and trade." wrapText="true"/>
                <HBox spacing="20.0">
                    <Label fx:id="eventStatusLabel" text="Status: -" styleClass="stat-value"/>
                    <Label fx:id="eventMmLabel" text="Market Maker: -" styleClass="stat-value"/>
                    <Label fx:id="eventBalanceLabel" text="Event Balance: $0.00" styleClass="stat-value"/>
                </HBox>
            </VBox>

            <!-- Order Book Dual Panel -->
            <VBox fx:id="orderBookContainer" spacing="10.0">
                <Label text="Order Book Trading" styleClass="section-title"/>
                <HBox spacing="15.0">
                    <!-- Option 1 Order Book -->
                    <VBox styleClass="card-panel" HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label fx:id="opt1NameLabel" text="Option 1" styleClass="section-title"/>
                        <GridPane hgap="12.0" vgap="6.0">
                            <HBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="LAST:" styleClass="stat-label"/>
                                <Label fx:id="opt1LastLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="BID:" styleClass="stat-label"/>
                                <Label fx:id="opt1BidLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="ASK:" styleClass="stat-label"/>
                                <Label fx:id="opt1AskLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="MID:" styleClass="stat-label"/>
                                <Label fx:id="opt1MidLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="SPREAD:" styleClass="stat-label"/>
                                <Label fx:id="opt1SpreadLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                        </GridPane>
                        <Label text="Buy Orders (BIDs)" styleClass="stat-label"/>
                        <TableView fx:id="opt1BuyTable" prefHeight="130.0"/>
                        <Label text="Sell Orders (ASKs)" styleClass="stat-label"/>
                        <TableView fx:id="opt1SellTable" prefHeight="130.0"/>
                    </VBox>

                    <!-- Option 2 Order Book -->
                    <VBox styleClass="card-panel" HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label fx:id="opt2NameLabel" text="Option 2" styleClass="section-title"/>
                        <GridPane hgap="12.0" vgap="6.0">
                            <HBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="LAST:" styleClass="stat-label"/>
                                <Label fx:id="opt2LastLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="BID:" styleClass="stat-label"/>
                                <Label fx:id="opt2BidLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="ASK:" styleClass="stat-label"/>
                                <Label fx:id="opt2AskLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="MID:" styleClass="stat-label"/>
                                <Label fx:id="opt2MidLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="SPREAD:" styleClass="stat-label"/>
                                <Label fx:id="opt2SpreadLabel" text="0.00" styleClass="stat-value"/>
                            </HBox>
                        </GridPane>
                        <Label text="Buy Orders (BIDs)" styleClass="stat-label"/>
                        <TableView fx:id="opt2BuyTable" prefHeight="130.0"/>
                        <Label text="Sell Orders (ASKs)" styleClass="stat-label"/>
                        <TableView fx:id="opt2SellTable" prefHeight="130.0"/>
                    </VBox>
                </HBox>

                <!-- Order Book Submit Order Form -->
                <VBox styleClass="card-panel" spacing="8.0">
                    <Label text="Submit Order Book Request" styleClass="section-title"/>
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <VBox spacing="2.0"><Label text="User:" styleClass="stat-label"/><ComboBox fx:id="userSelectorCombo" prefWidth="120.0"/></VBox>
                        <VBox spacing="2.0"><Label text="Option:" styleClass="stat-label"/><ComboBox fx:id="optionSelectorCombo" prefWidth="110.0"/></VBox>
                        <VBox spacing="2.0"><Label text="Action:" styleClass="stat-label"/><ComboBox fx:id="actionTypeCombo" prefWidth="90.0"/></VBox>
                        <VBox spacing="2.0"><Label text="Shares:" styleClass="stat-label"/><Spinner fx:id="countSpinner" prefWidth="90.0"/></VBox>
                        <VBox spacing="2.0"><Label text="Price/Share ($):" styleClass="stat-label"/><TextField fx:id="priceField" prefWidth="100.0" promptText="0.50"/></VBox>
                        <Button fx:id="submitOrderButton" text="Submit Order" onAction="#handleSubmitOrder" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- LMSR Trading Panel -->
            <VBox fx:id="lmsrContainer" styleClass="card-panel" spacing="10.0" visible="false">
                <Label text="LMSR Share Purchase" styleClass="section-title"/>
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <VBox spacing="2.0"><Label text="Option:" styleClass="stat-label"/><ComboBox fx:id="lmsrOptionCombo" prefWidth="130.0"/></VBox>
                    <VBox spacing="2.0"><Label text="Shares Count:" styleClass="stat-label"/><Spinner fx:id="lmsrCountSpinner" prefWidth="100.0"/></VBox>
                    <Button fx:id="lmsrBuyButton" text="Buy LMSR Shares" onAction="#handleBuyLMSR" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</SplitPane>
